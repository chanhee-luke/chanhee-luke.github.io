<div id="archive">
  <span class="h1">Publications</span>
  <p class="publications-legend">† indicates co-corresponding author. ‡ indicates project lead.</p>
  <ul class="post-list">
    <% var year = 0 %>
    <% var change = false %>
    <% var field_sort = theme.archive.sort_updated ? 'updated' : 'date' %>
    <% for (var paper of site.data.publications) { %>
      <% var itemYear = paper.date %>
      <% change = year !== itemYear %>
      <% year = change ? itemYear : year %>
      <% if (change) { %>
        <li class="post-year"><h2><%= year %></h2></li>
      <% } %>
      <li class="post-item">
        <p class="paper-name"><%= paper.name %></p>
        <p class="authors"><%- unescape(paper.authors.replace(/(Chan Hee Song)/gi, '<span>$1</span>')) %></p>
        <p class="links">
          <span class="tag"><%= paper.tag %></span>
          <span class="spotlight"><% if (Array.isArray(paper.spotlight)) { %><% for (var seg of paper.spotlight) { %><% if (seg.url) { %><a href="<%= seg.url %>" target="_blank" rel="noopener"><%= seg.text %></a><% } else { %><%= seg.text %><% } %><% } %><% } else { %><%- paper.spotlight %><% } %></span>

          <% if (paper.paper_url) { %>
            <a href="<%= paper.paper_url %>">Paper</a>
          <% } %>

          <% if (paper.project_url) { %>
            <a href="<%= paper.project_url %>">Website</a>
          <% } %>

          <% if (paper.code_url) { %>
            <a href="<%= paper.code_url %>">Code</a>
          <% } %>

          <% if (paper.data_url) { %>
            <a href="<%= paper.data_url %>">Data</a>
          <% } %>

          <% if (paper.reading_list) { %>
            <a href="<%= paper.reading_list %>">Reading List</a>
          <% } %>

          <% if (paper.slides_url) { %>
            <a href="<%= paper.slides_url %>">Slides</a>
          <% } %>

        </p>
      </li>
    <% } %>
  </ul>
</div>

